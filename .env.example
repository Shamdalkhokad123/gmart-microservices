# Copy to .env (never commit .env) and fill in every value.
# Generate random values with:  openssl rand -hex 32

# Shared by all services
JWT_SECRET=
INTERNAL_TOKEN=

# MySQL
MYSQL_ROOT_PASSWORD=
USER_DB_PASSWORD=
CATALOG_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=

# First admin account (remove ADMIN_PASSWORD after the first start)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay (live keys in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Delivery promise shown to customers (keep in sync with the frontend's business.ts)
DELIVERY_PROMISED_MINUTES=30
DELIVERY_RIDE_MINUTES=20
